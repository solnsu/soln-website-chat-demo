{
  "name": "@soln/chat-contracts",
  "version": "1.0.0",
  "description": "Versioned public Soln chat wire contracts and runtime validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
