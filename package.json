{
  "name": "soln-website-chat-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "chat:build": "npm run build --workspace @soln/chat-contracts && npm run build --workspace @soln/chat-sdk",
    "predev": "npm run chat:build",
    "dev": "next dev --hostname 0.0.0.0 --port 3008",
    "prebuild": "npm run chat:build",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3008",
    "pretypecheck": "npm run chat:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "6.5.2",
    "lucide-react": "1.61.0",
    "next": "16.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "@soln/chat-contracts": "1.0.0",
    "@soln/chat-sdk": "1.0.0",
    "@soln/chat-ui": "0.1.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@rc-component/virtual-list": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  }
}
